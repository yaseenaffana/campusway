# Google Maps API Configuration
# Get your free API key from: https://cloud.google.com/maps/gmp-get-started

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Note: Make sure these APIs are enabled in your Google Cloud Console:
# 1. Maps JavaScript API
# 2. Directions API
# 3. Distance Matrix API
# 4. Geolocation API (if using device geolocation)

# ============================================================
# CAMPUS SERVER CONFIGURATION (Updated - No Railway)
# ============================================================

# API URL - Set your development or campus server address
# Options:
# - Local development over HTTP: http://localhost:4010
# - Campus server: http://YOUR_CAMPUS_IP:4010 or http://your-domain.com:4010
PORT=4010
REACT_APP_API_URL=http://localhost:4010
VITE_API_URL=http://localhost:4010
VITE_PROXY_TARGET=http://localhost:4010
VITE_SOCKET_URL=http://localhost:4010

# Shared local development certificate
DEV_SSL_PFX=certs/dev-localhost.pfx
DEV_SSL_PASSPHRASE=mzsjs-buzz-dev
BACKEND_HTTPS=false

# Database Configuration (for server)
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourPassword
DB_NAME=CampusWay
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_USE_MOCK=false

# Production-only settings
PUBLIC_BASE_URL=http://your-domain.com
CORS_ORIGINS=http://your-domain.com,http://www.your-domain.com
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMP_ID=ADMIN001
HOST=0.0.0.0
NODE_ENV=development
