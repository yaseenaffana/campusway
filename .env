# ============================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ============================================================

# Backend API Configuration
# Local development prefers the same-origin Vite proxy and a shared HTTPS cert.
PORT=4010
VITE_PROXY_TARGET=https://localhost:4010
VITE_API_URL=https://localhost:4010
VITE_SOCKET_URL=https://localhost:4010
REACT_APP_API_URL=https://localhost:4010

# Shared local development certificate
DEV_SSL_PFX=certs/dev-localhost.pfx
DEV_SSL_PASSPHRASE=mzsjs-buzz-dev
BACKEND_HTTPS=true
SECONDARY_PASSWORD_DEFAULT=234567

# Google Maps API Configuration
# Get your free API key from: https://cloud.google.com/maps/gmp-get-started
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Gemini AI API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Environment
NODE_ENV=development
