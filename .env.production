# ===================================================================
# MZSJS BUZZ - Frontend Configuration
# ===================================================================
# Production Environment Variables

# ===================================================================
# API Configuration
# Backend Server IP: 103.207.1.92
# Backend Server Port: 4000
# ===================================================================
VITE_API_URL=http://103.207.1.92:4010
React_APP_API_URL=http://103.207.1.92:4010
VITE_SOCKET_URL=http://103.207.1.92:4010

# ===================================================================
# Google Maps Configuration
# Get your API key from: https://cloud.google.com/maps-platform
# ===================================================================
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ===================================================================
# Application Settings
# ===================================================================
VITE_APP_NAME=MZSJS BUZZ
VITE_APP_VERSION=1.0.0

# Location update frequency (milliseconds)
VITE_LOCATION_UPDATE_INTERVAL=1000

# Map configuration
VITE_MAP_CENTER_LAT=13.0827
VITE_MAP_CENTER_LNG=80.2707
VITE_MAP_ZOOM=13

# ===================================================================
# Feature Flags
# ===================================================================
VITE_ENABLE_DRIVER_APP=true
VITE_ENABLE_STUDENT_APP=true
VITE_ENABLE_ADMIN_DASHBOARD=true

# ===================================================================
# Development Settings
# ===================================================================
VITE_DEBUG_MODE=false
